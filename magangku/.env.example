# Salin ke `.env` -> `cp .env.example .env`
# File .env sudah masuk .gitignore. JANGAN commit file ini setelah diisi.

# --- Sumber data -------------------------------------------------------------
# Base URL API publik Kemnaker. Ubah hanya jika endpoint berpindah.
MAGANGKU_BASE_URL=https://maganghub.kemnaker.go.id/be/v1/api/

# Jeda antar request (detik). Mohon tetap sopan pada server publik.
MAGANGKU_DELAY=1.0
MAGANGKU_TIMEOUT=30
MAGANGKU_MAX_RETRIES=4

# --- Notifikasi (opsional) ---------------------------------------------------
# ntfy.sh: cukup pilih nama topik unik, lalu subscribe di HP.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Sesi MagangHub (opsional, HANYA untuk mode assisted) --------------------
# Sistem ini TIDAK PERNAH meminta password Anda.
# Bila ingin fitur yang butuh login (cek status lamaran), tempel cookie
# yang Anda ambil sendiri dari browser -> DevTools > Application > Cookies.
# Nilai ini hanya dipakai lokal dan tidak pernah dikirim ke pihak ketiga.
MAGANGHUB_COOKIE=
